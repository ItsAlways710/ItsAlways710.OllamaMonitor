<Window x:Class="ElBruno.OllamaMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Style="{DynamicResource ThemeWindowStyle}"
        Title="Settings - ItsAlways710.OllamaMonitor"
        Width="600"
        Height="750"
        MinWidth="600"
        MinHeight="700"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Icon="Assets/TrayIcons/tray-green.ico"
        WindowStartupLocation="CenterOwner">
    <DockPanel LastChildFill="True">
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ThemePanelBrush}"
                Padding="20,15">
            <StackPanel Margin="0">
                <TextBlock Text="Settings"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ThemeForegroundBrush}"
                           Margin="0" />
                <TextBlock Text="Configure notifications and application behavior"
                           FontSize="12"
                           Foreground="{DynamicResource ThemeSecondaryForegroundBrush}"
                           Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <!-- Buttons Footer -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ThemePanelBrush}"
                Padding="20,15">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CloseButton"
                        Content="Close"
                        Click="CloseButton_Click"
                        Padding="20,10"
                        Margin="0,0,10,0"
                        Background="#64748B"
                        FontSize="12"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand" />
                <Button x:Name="SaveButton"
                        Content="Save Settings"
                        Click="SaveButton_Click"
                        Padding="20,10"
                        Background="#3B82F6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand" />
            </StackPanel>
        </Border>

        <!-- Scrollable Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource ThemeBackgroundBrush}"
                      Padding="20,20,20,20">
            <StackPanel>
                <!-- Notifications Section -->
                <GroupBox Header="📢 Notifications"
                          Background="{DynamicResource ThemePanelBrush}"
                          Foreground="{DynamicResource ThemeForegroundBrush}"
                          Margin="0,0,0,20"
                          Padding="15">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="13" />
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <StackPanel>
                        <CheckBox x:Name="EnableNotificationsCheckBox"
                                  Content="Enable Windows Notifications"
                                  IsChecked="{Binding EnableNotifications}"
                                  Foreground="{DynamicResource ThemeForegroundBrush}"
                                  Margin="0,0,0,15"
                                  FontSize="13"
                                  Cursor="Hand" />

                        <TextBlock Text="Event Types:"
                                   Foreground="{DynamicResource ThemeSecondaryForegroundBrush}"
                                   Margin="0,10,0,10"
                                   FontSize="12"
                                   FontWeight="Bold" />

                        <!-- Ollama Events -->
                        <Border Background="{DynamicResource ThemeBackgroundBrush}"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,15"
                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Ollama Status"
                                           Foreground="{DynamicResource ThemeSecondaryForegroundBrush}"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Margin="0,0,0,10" />
                                <CheckBox x:Name="OllamaOfflineCheckBox"
                                          Content="🔴 Ollama goes offline"
                                          IsChecked="{Binding NotifyOllamaOffline}"
                                          Foreground="{DynamicResource ThemeForegroundBrush}"
                                          Margin="0,0,0,8"
                                          FontSize="12"
                                          Cursor="Hand" />
                                <CheckBox x:Name="OllamaOnlineCheckBox"
                                          Content="🟢 Ollama comes back online"
                                          IsChecked="{Binding NotifyOllamaOnline}"
                                          Foreground="{DynamicResource ThemeForegroundBrush}"
                                          FontSize="12"
                                          Cursor="Hand" />
                            </StackPanel>
                        </Border>

                        <!-- Model Events -->
                        <Border Background="{DynamicResource ThemeBackgroundBrush}"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,15"
                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Model Events"
                                           Foreground="{DynamicResource ThemeSecondaryForegroundBrush}"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Margin="0,0,0,10" />
                                <CheckBox x:Name="ModelLoadedCheckBox"
                                          Content="📦 Model is loaded"
                                          IsChecked="{Binding NotifyModelLoaded}"
                                          Foreground="{DynamicResource ThemeForegroundBrush}"
                                          Margin="0,0,0,8"
                                          FontSize="12"
                                          Cursor="Hand" />
                                <CheckBox x:Name="ModelUnloadedCheckBox"
                                          Content="📭 Model is unloaded"
                                          IsChecked="{Binding NotifyModelUnloaded}"
                                          Foreground="{DynamicResource ThemeForegroundBrush}"
                                          Margin="0,0,0,8"
                                          FontSize="12"
                                          Cursor="Hand" />
                                <CheckBox x:Name="ModelOperationSucceededCheckBox"
                                          Content="✅ Model operation succeeded (stop/pull/remove/copy)"
                                          IsChecked="{Binding NotifyModelOperationSucceeded}"
                                          Foreground="{DynamicResource ThemeForegroundBrush}"
                                          Margin="0,8,0,0"
                                          FontSize="12"
                                          Cursor="Hand" />
                                <CheckBox x:Name="ModelOperationFailedCheckBox"
                                          Content="❌ Model operation failed (stop/pull/remove/copy)"
                                          IsChecked="{Binding NotifyModelOperationFailed}"
                                          Foreground="{DynamicResource ThemeForegroundBrush}"
                                          Margin="0,8,0,0"
                                          FontSize="12"
                                          Cursor="Hand" />
                                <CheckBox x:Name="OllamaStartedCheckBox"
                                          Content="🚀 Ollama daemon start requested"
                                          IsChecked="{Binding NotifyOllamaStarted}"
                                          Foreground="{DynamicResource ThemeForegroundBrush}"
                                          Margin="0,8,0,0"
                                          FontSize="12"
                                          Cursor="Hand" />
                            </StackPanel>
                        </Border>

                        <!-- Resource Events -->
                        <Border Background="{DynamicResource ThemeBackgroundBrush}"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,15"
                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Resource Usage Alerts"
                                           Foreground="{DynamicResource ThemeSecondaryForegroundBrush}"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Margin="0,0,0,10" />
                                <CheckBox x:Name="HighCpuCheckBox"
                                          Content="⚠️  High CPU usage"
                                          IsChecked="{Binding NotifyHighCpu}"
                                          Foreground="{DynamicResource ThemeForegroundBrush}"
                                          Margin="0,0,0,8"
                                          FontSize="12"
                                          Cursor="Hand" />
                                <CheckBox x:Name="HighMemoryCheckBox"
                                          Content="⚠️  High memory usage"
                                          IsChecked="{Binding NotifyHighMemory}"
                                          Foreground="{DynamicResource ThemeForegroundBrush}"
                                          Margin="0,0,0,8"
                                          FontSize="12"
                                          Cursor="Hand" />
                                <CheckBox x:Name="HighGpuCheckBox"
                                          Content="⚠️  High GPU usage"
                                          IsChecked="{Binding NotifyHighGpu}"
                                          Foreground="{DynamicResource ThemeForegroundBrush}"
                                          FontSize="12"
                                          Cursor="Hand" />
                            </StackPanel>
                        </Border>

                        <!-- Debounce Setting -->
                        <StackPanel Margin="0,10,0,15">
                            <TextBlock Text="Notification Debounce (seconds)"
                                       Foreground="{DynamicResource ThemeSecondaryForegroundBrush}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="DebounceSlider"
                                        Width="300"
                                        Minimum="5"
                                        Maximum="300"
                                        Value="{Binding NotificationDebounceSeconds, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        Background="{DynamicResource ThemePanelBrush}"
                                        Foreground="{DynamicResource ThemeAccentBrush}"
                                        Margin="0,0,15,0"
                                        VerticalAlignment="Center" />
                                <TextBlock x:Name="DebounceValueBlock"
                                           Text="{Binding NotificationDebounceSeconds}"
                                           Foreground="{DynamicResource ThemeSecondaryForegroundBrush}"
                                           FontSize="13"
                                           Width="50"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center" />
                                <TextBlock Text="sec"
                                           Foreground="{DynamicResource ThemeSecondaryForegroundBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Prevents duplicate notifications for the same event within this time window"
                                       Foreground="{DynamicResource ThemeSecondaryForegroundBrush}"
                                       FontSize="11"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- General Section -->
                <GroupBox Header="⚙️  General"
                          Background="{DynamicResource ThemePanelBrush}"
                          Foreground="{DynamicResource ThemeForegroundBrush}"
                          Padding="15">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="13" />
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <StackPanel>
                        <CheckBox x:Name="LaunchAtStartupCheckBox"
                                  Content="Launch at Windows Startup"
                                  IsChecked="{Binding LaunchAtWindowsStartup}"
                                  Foreground="{DynamicResource ThemeForegroundBrush}"
                                  ToolTip="Start Ollama Monitor automatically when you sign in to Windows."
                                  Margin="0,0,0,10"
                                  FontSize="12"
                                  Cursor="Hand" />

                        <CheckBox x:Name="ShowFloatingCheckBox"
                                  Content="Show floating mini monitor on start"
                                  IsChecked="{Binding ShowFloatingWindowOnStart}"
                                  Foreground="{DynamicResource ThemeForegroundBrush}"
                                  FontSize="12"
                                  Cursor="Hand" />

                        <TextBlock Text="Unload Strategy"
                                   Foreground="{DynamicResource ThemeSecondaryForegroundBrush}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Margin="0,16,0,8" />
                        <ComboBox x:Name="UnloadStrategyComboBox"
                                  ItemsSource="{Binding UnloadStrategies}"
                                  SelectedItem="{Binding SelectedUnloadStrategy}"
                                  Padding="8"
                                  ToolTip="Auto uses CLI for local endpoints and API for remote endpoints." />
                    </StackPanel>
                </GroupBox>

                <!-- Mini Monitor Display Section -->
                <GroupBox Header="📊 Mini Monitor Display"
                          Background="{DynamicResource ThemePanelBrush}"
                          Foreground="{DynamicResource ThemeForegroundBrush}"
                          Padding="15"
                          Margin="0,20,0,0">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="13" />
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <StackPanel>
                        <CheckBox Content="Show CPU in Mini Monitor"
                                  IsChecked="{Binding ShowCpuInMiniMonitor}"
                                  Foreground="{DynamicResource ThemeForegroundBrush}"
                                  Margin="0,0,0,10"
                                  FontSize="12"
                                  Cursor="Hand" />
                        <CheckBox Content="Show Memory in Mini Monitor"
                                  IsChecked="{Binding ShowMemoryInMiniMonitor}"
                                  Foreground="{DynamicResource ThemeForegroundBrush}"
                                  Margin="0,0,0,10"
                                  FontSize="12"
                                  Cursor="Hand" />
                        <CheckBox Content="Show Context in Mini Monitor"
                                  IsChecked="{Binding ShowContextInMiniMonitor}"
                                  Foreground="{DynamicResource ThemeForegroundBrush}"
                                  Margin="0,0,0,10"
                                  FontSize="12"
                                  Cursor="Hand" />
                        <CheckBox Content="Show Ollama logs in Mini Monitor"
                                  IsChecked="{Binding ShowOllamaLogsInMiniMonitor}"
                                  Foreground="{DynamicResource ThemeForegroundBrush}"
                                  FontSize="12"
                                  Cursor="Hand" />
                    </StackPanel>
                </GroupBox>

                <!-- Spacing for ScrollViewer -->
                <TextBlock Margin="0,0,0,20" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
