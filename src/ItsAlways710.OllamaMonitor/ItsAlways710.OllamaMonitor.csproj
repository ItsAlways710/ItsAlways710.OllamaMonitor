<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>ItsAlways710.OllamaMonitor</AssemblyName>
    <RootNamespace>ItsAlways710.OllamaMonitor</RootNamespace>
    <Title>ItsAlways710.OllamaMonitor</Title>
    <AssemblyTitle>ItsAlways710.OllamaMonitor</AssemblyTitle>
    <Product>ItsAlways710.OllamaMonitor</Product>
    <Description>Windows-first Ollama monitor with live context tracking, real-time system and Ollama process metrics, themed windows, and configuration CLI. Built on the foundation of ElBruno.OllamaMonitor by Bruno Capuano.</Description>
    <Authors>ItsAlways710, Bruno Capuano (original)</Authors>
    <Company>ItsAlways710</Company>
    <Version>0.13.0</Version>
    <DebugType>embedded</DebugType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\TrayIcons\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

</Project>
